/target

# Node / tooling deps (web visual tests, docs-site)
node_modules/
**/node_modules/

# Playwright visual-test output
tests/visual/shots/
tests/visual/test-results/
tests/visual/playwright-report/

# Local session data (per-project, not source)
.koda/sessions/
# Learned-rule candidates are mined from however this checkout is used; they are
# local state, not part of the project.
.koda/learning/

# Built docs-site output
docs-site/dist/

# Rust build output in example projects (source-less build artifacts)
examples/**/target/

# OS / editor cruft
.DS_Store
